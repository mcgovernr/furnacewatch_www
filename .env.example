# Environment variables for furnacewatch-www marketing site
# Copy this file to .env (gitignored) and fill in values

# ── Site ──────────────────────────────────────────────────────────
SITE_URL=https://www.furnacewatch.io
# Used by Astro sitemap integration and canonical link tags

# ── App Portal ────────────────────────────────────────────────────
PUBLIC_APP_URL=https://app.furnacewatch.io
# The URL of the web application portal (React SPA)
# Used in "Portal Login" and "Request Demo" CTAs throughout the site

# ── Supabase (Portal Login) ───────────────────────────────────────
# Optional: if set, the /login page authenticates directly via Supabase
# and hands off the session to the webapp via /auth/callback.
# If NOT set, the login form simply redirects to ${PUBLIC_APP_URL}/login.
# PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Contact / Demo Form ───────────────────────────────────────────
# Option A: Formspree (simple, no backend needed)
# FORMSPREE_FORM_ID=your_form_id_here

# Option B: AWS SES (advanced, requires Lambda endpoint)
# SES_ENDPOINT=https://api.furnacewatch.io/contact

# ── Analytics ─────────────────────────────────────────────────────
# Option A: Plausible (privacy-first, recommended)
# PUBLIC_PLAUSIBLE_DOMAIN=furnacewatch.io

# Option B: Google Analytics 4
# PUBLIC_GA4_ID=G-XXXXXXXXXX

# ── Social ────────────────────────────────────────────────────────
PUBLIC_TWITTER_HANDLE=@furnacewatch
PUBLIC_LINKEDIN_URL=https://linkedin.com/company/furnacewatch

# ── Build flags ───────────────────────────────────────────────────
# Set to "true" to enable the /blog and /docs sections
# (useful to disable while content is thin at launch)
PUBLIC_SHOW_BLOG=true
PUBLIC_SHOW_DOCS=true

# ── Google Search Console ─────────────────────────────────────────
# Domain verification token; also emitted as a <meta name="google-site-verification"> tag
# PUBLIC_GOOGLE_SITE_VERIFICATION=
