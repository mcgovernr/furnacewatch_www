---
// PageLayout.astro — Standard page wrapper (BaseLayout + Header + Footer)
// Use for: all marketing pages
// For blog/docs that need different nav, extend separately.

import BaseLayout from './BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noIndex?: boolean;
  canonical?: string;
  publishDate?: Date;
  /** When true, header has transparent bg (for pages with full-bleed hero) */
  transparentHeader?: boolean;
}

const { transparentHeader = false, ...layoutProps } = Astro.props;
---

<BaseLayout {...layoutProps}>
  <Header transparent={transparentHeader} />
  <main id="main-content" class="flex-1">
    <slot />
  </main>
  <Footer />
</BaseLayout>
