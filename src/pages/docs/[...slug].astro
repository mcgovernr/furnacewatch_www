---
// src/pages/docs/[...slug].astro — Individual docs page (light theme)
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import PageLayout from '@layouts/PageLayout.astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const docs = await getCollection('docs', ({ data }) => !data.draft);
  return docs.map(doc => ({
    params: { slug: doc.slug },
    props: { doc },
  }));
};

const { doc } = Astro.props;
const { Content } = await doc.render();

// Sidebar: all docs grouped by section for navigation
const allDocs = await getCollection('docs', ({ data }) => !data.draft);
const sections = [
  'Getting Started',
  'Installation',
  'Platform Overview',
  'Devices & Sensors',
  'Alerts & Notifications',
  'Intelligence & ML',
  'Integrations',
  'API Reference',
  'Administration',
  'Troubleshooting',
] as const;
---

<PageLayout
  title={`${doc.data.title} — Docs`}
  description={doc.data.description}
>
  <div class="bg-white">
    <div class="container-fw py-12">
      <div class="grid lg:grid-cols-[260px_1fr] gap-12">

        <!-- Sidebar -->
        <aside class="hidden lg:block">
          <nav class="sticky top-24 space-y-8">
            {sections.map(section => {
              const pages = allDocs
                .filter(d => d.data.section === section)
                .sort((a, b) => a.data.order - b.data.order);
              if (!pages.length) return null;
              return (
                <div class="space-y-1">
                  <p class="text-xs font-semibold text-navy-900 uppercase tracking-widest mb-3">{section}</p>
                  {pages.map(page => (
                    <a
                      href={`/docs/${page.slug}`}
                      class:list={[
                        'block text-sm px-3 py-2 rounded-lg transition-colors no-underline',
                        page.slug === doc.slug
                          ? 'bg-heat-500/10 text-heat-700 font-medium'
                          : 'text-navy-500 hover:text-navy-900 hover:bg-navy-100',
                      ]}
                    >
                      {page.data.title}
                    </a>
                  ))}
                </div>
              );
            })}
          </nav>
        </aside>

        <!-- Content -->
        <main>
          <div class="flex items-center gap-3 mb-6">
            <span class="text-xs text-navy-400">{doc.data.section}</span>
            {doc.data.badge && <span class="badge-heat text-xs">{doc.data.badge}</span>}
          </div>
          <h1 class="text-3xl font-display font-bold text-navy-900 mb-8">{doc.data.title}</h1>
          <div class="prose-fw">
            <Content />
          </div>
        </main>
      </div>
    </div>
  </div>
</PageLayout>
