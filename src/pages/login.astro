---
// login.astro — Redirect to the app portal login.
// The marketing site no longer hosts a login form (REDESIGN_PLAN §1.3):
// one login surface, on app.furnacewatch.io.
import BaseLayout from '@layouts/BaseLayout.astro';

const appUrl = import.meta.env.PUBLIC_APP_URL || 'https://app.furnacewatch.io';
const loginUrl = `${appUrl}/login`;
---

<BaseLayout
  title="Sign In — FurnaceWatch"
  description="Sign in to the FurnaceWatch portal."
  noIndex={true}
>
  <div class="min-h-screen bg-navy-50 flex items-center justify-center px-4">
    <div class="text-center space-y-4">
      <p class="text-navy-600">Taking you to the FurnaceWatch portal…</p>
      <a href={loginUrl} class="btn btn-primary">Continue to sign in</a>
    </div>
  </div>

  <script is:inline define:vars={{ loginUrl }}>
    window.location.replace(loginUrl);
  </script>
</BaseLayout>
