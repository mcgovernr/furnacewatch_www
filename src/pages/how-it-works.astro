---
// src/pages/how-it-works.astro — Sensor → install → portal → alert (v2 IA; replaces /features)
import PageLayout from '@layouts/PageLayout.astro';
import CTASection from '@components/CTASection.astro';

const capabilities = [
  { title: 'Watches the furnace itself', desc: 'The sensor mounts on the furnace cabinet and follows every heating cycle — the heat call from the thermostat wires, and the mechanical activity of the inducer, ignition, and blower.' },
  { title: 'Names the failure', desc: 'When a cycle goes wrong, the failure gets a name — heat call with no ignition, igniter failure, flame sensor failure, a pressure switch or rollout trip, short cycling — not just an “error” light.' },
  { title: 'Detection on the sensor', desc: 'Classification runs on the device itself. A Wi-Fi drop at the home never means an unwatched furnace, and the portal flags any sensor that stops reporting.' },
  { title: 'Push alerts to your team', desc: 'The moment a failure is identified, a push notification lands on your team’s phones with the failure mode and the timeline.' },
  { title: 'Fleet view and health scores', desc: 'Every monitored furnace in one list, with two health scores per unit — the furnace and the sensor watching it — and cycle history for context before the truck rolls.' },
  { title: 'Customer logins, scoped', desc: 'Homeowners and property managers can sign in and see only their own equipment, under your company’s service. Your fleet stays yours.' },
];
---

<PageLayout
  title="How Furnace Monitoring Works"
  description="How FurnaceWatch furnace monitoring works: your tech installs the sensor in one maintenance visit, it watches every heating cycle, and your office knows first."
>
  <!-- Hero -->
  <section class="section-sm bg-navy-50 border-b border-navy-200">
    <div class="container-fw text-center flex flex-col items-center gap-4 max-w-3xl mx-auto">
      <span class="section-eyebrow">How it works</span>
      <h1 class="section-title text-4xl sm:text-[44px]">Built for the realities of HVAC service.</h1>
      <p class="section-subtitle max-w-2xl">
        A sensor your technician installs in a maintenance visit. A portal your office watches.
        An alert that names the failure before the customer calls.
      </p>
    </div>
  </section>

  <!-- Install -->
  <section class="section bg-white">
    <div class="container-fw max-w-3xl mx-auto flex flex-col gap-8">
      <div class="flex flex-col gap-4">
        <span class="section-eyebrow">The install</span>
        <h2 class="section-title text-3xl">One maintenance visit. No homeowner homework.</h2>
      </div>
      <ol class="flex flex-col gap-5 list-none p-0 m-0">
        {[
          'The sensor mounts to the furnace cabinet — no modifications to the furnace.',
          'It powers from the furnace’s own 24V transformer, with battery ride-through. No batteries to change, no wall wart to find an outlet for.',
          'It senses the heat call directly from the thermostat wires, so it always knows what the furnace was asked to do.',
          'Wi-Fi is configured before the unit ships, so on site it’s mount, land the low-voltage connections, and go.',
        ].map((step, i) => (
          <li class="flex items-start gap-4">
            <span class="font-display font-extrabold text-heat-600 text-lg leading-7 shrink-0">{String(i + 1).padStart(2, '0')}</span>
            <span class="text-navy-600 leading-relaxed">{step}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Capabilities -->
  <section class="section bg-navy-50 border-y border-navy-200">
    <div class="container-fw flex flex-col gap-11">
      <div class="flex flex-col gap-4 max-w-2xl">
        <span class="section-eyebrow">Capabilities</span>
        <h2 class="section-title text-3xl">Every feature has a job on a service desk.</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {capabilities.map(c => (
          <div class="card p-6 flex flex-col gap-2.5">
            <h3 class="font-display font-bold text-base text-navy-900">{c.title}</h3>
            <p class="text-sm text-navy-500 leading-relaxed">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What the alert says -->
  <section class="section bg-white">
    <div class="container-fw max-w-3xl mx-auto flex flex-col gap-6">
      <span class="section-eyebrow">What the alert says</span>
      <h2 class="section-title text-3xl">Enough to load the truck.</h2>
      <div class="rounded-xl overflow-hidden border border-navy-200 shadow-card">
        <div class="bg-navy-900 px-5 py-3">
          <span class="font-mono text-xs text-navy-400">FurnaceWatch alert · 5:43 AM</span>
        </div>
        <div class="bg-[#1d1c19] p-6 flex flex-col gap-2">
          <p class="text-critical-dark font-semibold">Heat call with no ignition — Furnace 07</p>
          <p class="text-navy-300 text-sm leading-relaxed">
            Thermostat calling for heat since 5:42 AM. Inducer not detected, ignition not detected.
            Last normal cycle completed 11:20 PM.
          </p>
        </div>
      </div>
      <p class="text-navy-500 leading-relaxed">
        The dispatcher sees the failure mode and the timeline before assigning the truck.
        The technician walks in already knowing what failed. See
        <a href="/what-it-catches">the full list of what it catches</a>.
      </p>
    </div>
  </section>

  <CTASection />
</PageLayout>
