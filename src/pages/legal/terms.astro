---
// src/pages/legal/terms.astro — Website terms of use
import PageLayout from '@layouts/PageLayout.astro';
---

<PageLayout
  title="Terms of Use"
  description="Terms of use for the FurnaceWatch website."
>
  <section class="section-sm bg-navy-50 border-b border-navy-200">
    <div class="container-fw max-w-3xl mx-auto space-y-3">
      <span class="section-eyebrow">Legal</span>
      <h1 class="section-title text-4xl">Terms of use</h1>
      <p class="text-sm text-navy-400">Last updated August 30, 2026</p>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-fw max-w-3xl mx-auto space-y-8 text-navy-600 leading-relaxed">
      <div class="space-y-3">
        <h2 class="text-xl font-display font-semibold text-navy-900">About this site</h2>
        <p>
          This website describes the FurnaceWatch product and lets you get in touch with us.
          Use of the FurnaceWatch service itself — the sensor and the portal at
          app.furnacewatch.io — is governed by the service agreement between FurnaceWatch and
          your organization, not by these terms.
        </p>
      </div>

      <div class="space-y-3">
        <h2 class="text-xl font-display font-semibold text-navy-900">Information on this site</h2>
        <p>
          We work to keep what's published here accurate and current, and the product is under
          active development. Content on this site is provided for general information and isn't
          a warranty, a service commitment, or professional advice. Product capabilities,
          availability, and pricing are confirmed in writing when you engage with us.
        </p>
      </div>

      <div class="space-y-3">
        <h2 class="text-xl font-display font-semibold text-navy-900">Intellectual property</h2>
        <p>
          FurnaceWatch, the FurnaceWatch name, and the content of this site belong to
          FurnaceWatch. You're welcome to link to any page.
        </p>
      </div>

      <div class="space-y-3">
        <h2 class="text-xl font-display font-semibold text-navy-900">Contact</h2>
        <p>
          Questions about these terms: <a href="mailto:info@furnacewatch.io">info@furnacewatch.io</a>.
        </p>
      </div>
    </div>
  </section>
</PageLayout>
