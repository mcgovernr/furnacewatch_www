---
// StatBar.astro — Horizontal strip of key metrics / proof points
// Used below the hero and in other proof sections

export interface Stat {
  value: string;
  label: string;
  suffix?: string;
}

export interface Props {
  stats: Stat[];
  variant?: 'dark' | 'border';
}

const {
  stats = [],
  variant = 'border',
} = Astro.props;
---

<div
  class:list={[
    'grid divide-y sm:divide-y-0 sm:divide-x',
    `sm:grid-cols-${Math.min(stats.length, 4)}`,
    variant === 'border'
      ? 'border border-navy-200 rounded-2xl divide-navy-200 overflow-hidden'
      : 'divide-navy-100',
  ]}
>
  {stats.map((stat) => (
    <div class="flex flex-col items-center justify-center gap-1 px-6 py-6 sm:py-8 text-center">
      <div class="font-display text-3xl sm:text-4xl font-bold tracking-tight">
        <span class="gradient-text">{stat.value}</span>
        {stat.suffix && <span class="text-2xl text-heat-500">{stat.suffix}</span>}
      </div>
      <div class="text-sm text-navy-500 leading-snug max-w-[120px]">{stat.label}</div>
    </div>
  ))}
</div>
