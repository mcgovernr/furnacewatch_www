---
// TestimonialCard.astro — Customer quote card

export interface Props {
  quote: string;
  name: string;
  title: string;
  company: string;
  avatarInitials?: string;
  rating?: number; // 1-5
}

const { quote, name, title, company, avatarInitials, rating = 5 } = Astro.props;
const initials = avatarInitials || name.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2);
---

<div class="card p-6 flex flex-col gap-5">
  <!-- Stars -->
  {rating > 0 && (
    <div class="flex items-center gap-0.5" aria-label={`${rating} out of 5 stars`}>
      {Array.from({ length: 5 }).map((_, i) => (
        <svg
          class:list={['w-4 h-4', i < rating ? 'text-heat-400' : 'text-navy-700']}
          fill="currentColor"
          viewBox="0 0 20 20"
          aria-hidden="true"
        >
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
      ))}
    </div>
  )}

  <!-- Quote -->
  <blockquote class="text-navy-600 text-sm leading-relaxed flex-1">
    "{quote}"
  </blockquote>

  <!-- Attribution -->
  <div class="flex items-center gap-3 pt-2 border-t border-navy-200">
    <!-- Avatar -->
    <div class="w-10 h-10 rounded-full bg-gradient-heat flex items-center justify-center text-white text-sm font-bold shrink-0">
      {initials}
    </div>
    <div class="min-w-0">
      <div class="text-sm font-semibold text-navy-900 truncate">{name}</div>
      <div class="text-xs text-navy-400 truncate">{title}, {company}</div>
    </div>
  </div>
</div>
